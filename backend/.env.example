# Environment Configuration Example
PROJECT_NAME="FoodHub - Online Food Delivery Platform"
SECRET_KEY="super-secret-jwt-key-foodhub-2026-secure-token-998811"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: PostgreSQL for AWS RDS / Production Docker, or SQLite for local dev
DATABASE_URL="postgresql://foodhub_user:securepassword123@db:5432/foodhub_db"

# AWS Cloud Services
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET_NAME="foodhub-restaurant-assets"
AWS_CLOUDWATCH_LOG_GROUP="/foodhub/api-logs"
